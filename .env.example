NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: report/evaluation only. Photon NEVER reads or requires this key.
OPENAI_API_KEY=
# Photon Spectrum project Settings: SECRET_KEY -> PHOTON_API_KEY; PROJECT_ID -> PHOTON_PROJECT_ID.
# These remain server-only. Do not use a dashboard bearer token as PHOTON_API_KEY.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
# Legacy aliases are supported; PHOTON_* takes precedence. Leave aliases blank for new setups.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Generate a private random value of at least 32 characters for session encryption.
MISSION_SESSION_SECRET=
SUBMISSION_HASH_SECRET=
NEXT_PUBLIC_APP_URL=
